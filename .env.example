GEMINI_API_KEY=replace-with-your-key
GEMINI_MODEL=gemini-2.5-flash
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=idps
POSTGRES_DB=idps
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-separate-strong-password
# Optional override for managed PostgreSQL; URL-encode passwords in URLs.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/idps?ssl=require
AUTO_CREATE_TABLES=false
DOMAIN=documents.example.com
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20
MAX_CONCURRENT_JOBS=1
OCR_MAX_SIDE_PX=2400
PRELOAD_MODELS=true
CORS_ORIGINS=http://localhost:5173
DEBUG=false
PRESENTATION_AUTH_ENABLED=false
PRESENTATION_USERNAME=presenter
# Set in the private .env when enabling a temporary presentation tunnel.
# PRESENTATION_PASSWORD=use-a-strong-password
